NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/greenbloom
JWT_SECRET=your_super_secret_jwt_key
ALLOWED_ORIGINS=https://greenbloom.vercel.app,https://admin-greenbloom.vercel.app
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Email Configuration (SMTP Gmail Pooled)
# Your Gmail address used to authenticate and send emails
EMAIL_USER=plantsvigor@gmail.com
# 16-character Google App Password (NOT your primary account password).
# Generate this at: Google Account > Security > 2-Step Verification > App Passwords.
EMAIL_PASS=your_16_char_google_app_password
